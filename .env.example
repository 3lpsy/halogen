# Local config + secrets — copy to `.env` (gitignored) and fill in. The justfile
# auto-loads it (`set dotenv-load`) and derives the cargo index var from
# SERVICES_ROOT_DOMAIN; raw cargo outside `just` still needs those exported.
# Shell env WINS over this file. Format: KEY=value; '#' comments; quotes stripped.

## ── In-cluster services ──────────────────────────────────────────────────────
# Root domain every in-cluster hostname derives from (deps.<domain>, ...).
# The domain itself is never committed to the repo. Without it, set the
# explicit knobs below instead.
SERVICES_ROOT_DOMAIN=

## ── Derived endpoints (explicit knob > derived from SERVICES_ROOT_DOMAIN) ────
# CARGO_REGISTRIES_CHILLED_PROXY_INDEX=sparse+https://index.crates.io/  # default: sparse+https://deps.<root>/crates/index/
# TOOLCHAIN_IMAGE=halogen-toolchain:local  # docker-* runs (default: registry.<root>/halogen-toolchain:latest)

## ── Container builds (docker-build-*) ────────────────────────────────────────
# CONTAINER_ENGINE=docker       # default: podman if present, else docker
# CI_BASE_IMAGE=                # toolchain base — REQUIRED for docker-build-toolchain
# DEV_BASE_IMAGE=               # dev runtime base (default: docker.io/library/fedora:44)

## ── Server (HALOGEN_* — every config field also has a CLI flag / TOML key) ────
# JWT signing secret — required to boot; must stay stable across restarts or
# every session is invalidated. `just dev-server` falls back to "dev-secret".
# HALOGEN_AUTH_TOKEN_SECRET=
# HALOGEN_AUTH_TOKEN_EXPIRY_MINUTES=10080
# HALOGEN_LISTEN_ADDRESS=127.0.0.1
# HALOGEN_LISTEN_PORT=8080
# HALOGEN_DB_PATH=halogen.db
# HALOGEN_MEDIA_ROOT=.
# HALOGEN_DB_NO_MIGRATE=false
# HALOGEN_DB_NO_WAL=false
# HALOGEN_DEV_SEED_DATA=false          # debug/dev-seed builds only
# HALOGEN_LOG_LEVEL=info
# HALOGEN_LOG_FILE=               # also append logs to this file (stdout stays on)
# HALOGEN_CONFIG=                 # path to a TOML config file

## ── iOS build caching (CI sets these; leave unset locally) ──────────────────
# Absolute directory the build runs from, so compiler paths repeat across runs
# instead of moving with the runner's per-run checkout. Unset = build here.
# HALOGEN_WORK_DIR=
# Non-empty discards that directory before syncing (bad-cache escape hatch).
# HALOGEN_WORKDIR_RESET=
# Extra xcodebuild settings, appended verbatim, e.g. "FOO=YES BAR=NO".
# Use ios-cache-probe results for caching settings; Xcode silently accepts misspelled keys.
# HALOGEN_XCODE_SETTINGS=
# Non-empty re-runs xcodegen even when its inputs are unchanged.
# HALOGEN_XCODEGEN_FORCE=

## ── Apple signing and TestFlight ────────────────────────────────────────────
# APPLE_SIGNING_IDENTITY=Apple Distribution: Your Organization (TEAMID1234)
# APPLE_P12_PATH=                # exported distribution identity, required for local signing
# APPLE_P12_PASSWORD=
# IOS_PROVISIONING_PROFILE=/absolute/protected/path/Halogen_AppStore.mobileprovision
# APPLE_TEAM_ID=                 # optional; asserted against the IPA's profile
# ASC_API_KEY_ID=
# ASC_API_ISSUER_ID=
# ASC_API_KEY_PATH=              # default: ~/.appstoreconnect/private_keys/AuthKey_<ASC_API_KEY_ID>.p8
# ASC_PROVIDER=                  # only for an account that belongs to several teams
# HALOGEN_TRANSPORTER_DIR=        # default: data/signing/transporter (just ios-transporter-setup)
# HALOGEN_TRANSPORTER_ACCEPT=     # =1 accepts Apple's Transporter licence unprompted
# HALOGEN_UPLOAD_YES=             # =1 skips the TestFlight confirmation prompt
# HALOGEN_SIGNING_RUNTIME=container # native uses installed Linux tools without nested containers

## ── Dev-device signing (Linux device loop) ─────────────────────────
# Keep development credentials separate from APPLE_*/IOS_* distribution material.
# Register the device in a profile covering org.fgsec.halogen.dev and org.fgsec.halogen.dev.xctrunner.
# DEV_DEVICE_UDID=               # `idevice_id -l` with the dev phone plugged in
# DEV_DEVICE_P12_PATH=data/internal/apple-dev/halogen-dev.p12
# DEV_DEVICE_P12_PASSWORD=
# DEV_DEVICE_PROVISIONING_PROFILE=data/internal/apple-dev/Halogen_Dev.mobileprovision
# Device e2e networking: the phone reaches the sandbox test server over the
# LAN at http://<host-ip>:<port>. Publish the port when creating the sandbox
# (ai.sh --port $DEV_DEVICE_E2E_PORT); the launcher injects AISANDBOX_HOST_IP
# and AISANDBOX_PORTS. The test server must listen on 0.0.0.0 to be reachable.
# DEV_DEVICE_E2E_PORT=38080     # must fall inside a published --port range
# DEV_DEVICE_HOST_IP=            # override AISANDBOX_HOST_IP if detection picks the wrong iface

# Additional Halogen tooling.
# NPM_REGISTRY=                 # defaults to the dependency proxy npm mount
# CHILLED_PROXY_URL=            # Maven/Gradle proxy mount base
# HALOGEN_SERVER_URL=           # remote server for physical-device journeys
# HALOGEN_DARWIN_PLATFORMS=     # mounted Darwin SDK Platforms directory
# HALOGEN_SWIFT_JOBS=4
# HALOGEN_SIGNING_DIR=data/signing

# Create Halogen-specific signing material before device testing; paths above are placeholders.
