# Local config + secrets — copy to `.env` (gitignored) and fill in. The justfile
# auto-loads it (`set dotenv-load`) and derives the cargo index var from
# SERVICES_ROOT_DOMAIN; raw cargo/npm outside `just` still needs those exported.
# Shell env WINS over this file. Format: KEY=value; '#' comments; quotes stripped.

## ── In-cluster services ──────────────────────────────────────────────────────
# Root domain every in-cluster hostname derives from (git.<domain>,
# deps.<domain>, registry.<domain>, …). The domain itself is
# never committed to the repo. Without it, set the explicit knobs below instead.
SERVICES_ROOT_DOMAIN=

## ── Derived endpoints (explicit knob > derived from SERVICES_ROOT_DOMAIN) ────
# Each defaults from the root domain; set explicitly to point elsewhere — e.g.
# the public upstreams below when you don't run the in-cluster mirrors.
# CARGO_REGISTRIES_CHILLED_PROXY_INDEX=sparse+https://index.crates.io/  # default: sparse+https://deps.<root>/crates/index/
# NPM_REGISTRY=https://registry.npmjs.org/  # default: https://deps.<root>/npm/, else fails closed
# TOOLCHAIN_IMAGE=halogen-toolchain:local   # `just image-*` base (default: registry.<root>/halogen-toolchain:latest)

## ── Git (in-cluster Forgejo; the clone token) ────────────────────────────────
# Repo-scoped READ token (Forgejo → Settings → Applications; repository: read
# is enough). Used only inside the throwaway build VM.
# TART_FORGEJO_TOKEN=
# TART_FORGEJO_HOST=            # override; default: git.<SERVICES_ROOT_DOMAIN>
# TART_FORGEJO_OWNER=           # repo owner — REQUIRED for the tart build flows
# TART_FORGEJO_REPO=halogen

## ── just tart-release (optional overrides) ───────────────────────────────────
# TART_TAG=v0.1.18              # default: v<version> from Cargo.toml [workspace.package]
# TART_VM_NAME=halogen-builder  # the packer-built base VM to clone per build
# TART_VM_PASSWORD=admin        # cirruslabs image default
# TART_OUT_DIR=                 # default: ci/tart/artifacts/<TART_TAG>
# TART_BOOT_TIMEOUT=300         # seconds to wait for the VM's IP + SSH
# TART_KEEP_VM=                 # =1 keeps the per-build VM (debugging; clone holds the token!)
# TART_SKIP_SIGN=               # =1 to skip the sign-*.sh steps after the build
# TART_IOS_BUILD_ARGS=          # extra dx args — e.g. `--device true` for a device build

## ── just tart-build-vm (optional overrides) ──────────────────────────────────
# TART_BASE_IMAGE=ghcr.io/cirruslabs/macos-tahoe-xcode:latest
# TART_VM_CPU=8
# TART_VM_MEMORY_GB=16
# TART_VM_DISK_GB=
# TART_HOME=/Volumes/DevboxExt/Tart  # tart image/VM storage (external SSD; env.sh default)

## ── just tart-devboxvm (tailnet remote-dev VM) ───────────────────────────────
# Persistent remote-dev clone; joins the tailnet as the `devbox` user with
# hostname `devboxvm` (no collision with the mac host's node).
# TART_TAILSCALE_URL=           # tailnet login server, e.g. https://<login-server-domain>
# TART_TS_AUTHKEY=              # tailnet preauth key (devbox user, 2nd key)
# TART_SSH_PRIV_KEY_PATH=       # host path of a private key → VM ~/.ssh/id_ed25519 (forgejo read/write git)
# TART_SSH_PUB_KEYS=            # CSV of '<type> <key> <comment>' pubkeys → VM authorized_keys
# TART_DEVBOX_VM=devboxvm       # tart VM name AND tailnet hostname

## ── Apple signing (just tart-sign) ───────────────────────────────────────────
# The cert CN embeds your name + Team ID (inherent to codesigning); your Apple
# ID email never leaves this file. See docs/internal/TART.md "Signing".
# APPLE_SIGNING_IDENTITY=Apple Development: Your Name (TEAMID1234)
# APPLE_TEAM_ID=TEAMID1234
# APPLE_P12_PATH=          # exported cert+key; omit if the identity is already in your login keychain
# APPLE_P12_PASSWORD=
# IOS_PROVISIONING_PROFILE=  # .mobileprovision covering org.fgsec.halogen + your device UDIDs
# APPLE_ID_EMAIL=          # only for future notarization (notarytool); stays local

# (Tart is Apple-only: mac desktop today, the native iOS app (ios/) once its
#  release/device build is wired up.)
