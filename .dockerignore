# Keep the Docker build context small + reproducible. The images regenerate all
# build artifacts themselves (cargo build, npm ci, wasm-bindgen, tailwind).
.git/
target/
**/target/
node_modules/
**/node_modules/

# Generated frontend bundle, rebuilt by `just ui-build` inside the image.
# The .gitkeep keeper must stay in the context: without it dist/ is empty and
# COPY . . drops the dir entirely, breaking the rust_embed compile.
dist/*
!dist/.gitkeep

# Local dev state (DB, media, logs) — never belongs in an image. EXCEPT
# data/tests: the server's unit tests read RSS + mp3 fixtures from there (tracked
# in git), resolved at /workspace/data/tests inside the testing image. Without
# this the rss/polling/download tests panic "test fixture not found".
data/*
!data/tests
!data/assets
**/*.log

# Secrets: the repo-root .env (tokens and signing config) and Apple signing
# material must NEVER be baked into an image by COPY . . .
.env
.env.local
**/*.p12
**/*.mobileprovision
**/*.pem

# Big local build outputs (host-side; CI checkouts don't have them, but local
# `just image-*` builds would drag in GBs).
artifacts/
.sccache/

# Keep CI helpers, workflow inventories and native sources for check-all.
# Exclude generated mobile state and signing outputs instead of entire trees.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/src/main/jniLibs/
android/generated/
ios/build/
ios/.build/
ios/.cache/
ios/.swiftpm/
ios/UITestsPkg/.build/
ios/UITestsPkg/.swiftpm/
ios/xtool/
ios/Generated/
docs/

# Editor / agent / OS cruft.
.idea/
.vscode/
.zed/
.claude/
.opencode/
CLAUDE.md
.DS_Store

.agents/

**/*.p8
