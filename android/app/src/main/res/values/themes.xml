<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this is just the pre-Compose window frame.
         Dark to match the app's dark-default theme (no white flash at launch). -->
    <style name="Theme.Halogen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
    </style>
</resources>
