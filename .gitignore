# ── Rust / Cargo ──────────────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
rustc-ice-*.txt

# ── Frontend (dx / node / tailwind) ───────────────────────────────────────────
.dioxus/
node_modules/
*.wasm
# Generated by `just tailwind` (the other crates/ui/assets/ files stay committed).
crates/ui/assets/tailwind.css

# Built frontend: ignore contents, keep dist/ itself (.gitkeep) — the server's
# rust_embed needs the folder to EXIST at compile time on fresh checkouts;
# `just ui-build` fills it.
/dist/*
!/dist/.gitkeep

# ── Native iOS app (ios/) ─────────────────────────────────────────────────────
# Xcode project + Info.plist are xcodegen-generated (project.yml is the source
# of truth); Generated/ + Rust/ are staged Rust build products (just ios-core);
# build/ is the xcodebuild derived-data dir.
/ios/Halogen.xcodeproj/
/ios/Halogen/Info.plist
/ios/Generated/
/ios/Rust/
/ios/build/

# ── Native Android app (android/) ────────────────────────────────────────────
# generated/ = typeshare wire DTOs + UniFFI Kotlin bindings (just android-core);
# jniLibs/ = staged per-ABI Rust .so; the rest is Gradle build state.
/android/generated/
/android/app/src/main/jniLibs/
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/.kotlin/

# ── Dev / test data (keep the dirs, ignore the contents) ─────────────────────
# Dev data (SQLite db + downloaded media) created by `just dev-server`.
/data/devdata/*
!/data/devdata/.gitkeep
# Media written by e2e tests (e.g. download_to_device_journey).
/crates/e2e/media/*
!/crates/e2e/media/.gitkeep
data/devdeploy/
data/scratch/

# Screenshot walkthrough output (tool-screenshot, under data/screenshots/web/).
# `*` (not the bare dir) so the COMMITTED iOS/Android journey shots can be
# re-included — git can't re-include children of an excluded directory.
data/screenshots/*
!data/screenshots/ios/
!data/screenshots/android/

# E2e / release-staging run artifacts (just ios-e2e / android-e2e / *-screenshots).
/artifacts/
data/android/artifacts/
data/ios/artifacts/

# ── Release / CI ──────────────────────────────────────────────────────────────
# Staged debug binary the dev-release CI copies into the ci/docker/dev build context.
/halogen-server
# Tart VM build outputs + signing material (ci/tart) — artifacts and keys
# never belong in git.
/ci/tart/artifacts/
*.p12
*.jks
*.mobileprovision
*.pem
*.pem.pub

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local

# ── Local caches ──────────────────────────────────────────────────────────────
# Local sccache cache dir (SCCACHE_DIR in .cargo/config.toml).
/.sccache/

# ── Editors / agents / OS ─────────────────────────────────────────────────────
.claude/
.idea/
.vscode/
.zed/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.bak
*~
