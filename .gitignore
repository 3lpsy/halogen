# ── Rust / Cargo ──────────────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
rustc-ice-*.txt

.claude/settings.local.json

# ── Frontend (dx / node / tailwind) ───────────────────────────────────────────
.dioxus/
node_modules/
*.wasm
# Generated by `just tailwind` (the other webui/app/assets/ files stay committed).
webui/app/assets/tailwind.css

# Built frontend: ignore contents, keep dist/ itself (.gitkeep) — the server's
# rust_embed needs the folder to EXIST at compile time on fresh checkouts;
# `just ui-build` fills it.
/dist/*
!/dist/.gitkeep

# ── Native iOS app (ios/) ─────────────────────────────────────────────────────
# Xcode project + Info.plist are xcodegen-generated (project.yml is the source
# of truth); Generated/ + Rust/ are staged Rust build products (just ios-core);
# build/ is the xcodebuild derived-data dir.
/ios/Halogen.xcodeproj/
/ios/Halogen/Info.plist
/ios/Generated/
/ios/Rust/
/ios/build/

# ── Native Android app (android/) ────────────────────────────────────────────
# generated/ = typeshare wire DTOs + UniFFI Kotlin bindings (just android-core);
# jniLibs/ = staged per-ABI Rust .so; the rest is Gradle build state.
/android/generated/
/android/app/src/main/jniLibs/
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/.kotlin/

# ── Dev / test data (keep the dirs, ignore the contents) ─────────────────────
# Media written by e2e tests (e.g. download_to_device_journey).
/crates/e2e/media/*
!/crates/e2e/media/.gitkeep
data/devdeploy/
data/scratch/

# E2e / release-staging run artifacts (just ios-e2e / android-e2e / *-screenshots).
/artifacts/

# ── Release / CI ──────────────────────────────────────────────────────────────
# Staged debug binary the dev-release CI copies into the ci/docker/dev build context.
/halogen-server
# Signing material never belongs in git.
*.p12
*.jks
*.mobileprovision
*.pem
*.pem.pub

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local

# ── Local caches ──────────────────────────────────────────────────────────────
# Local sccache cache dir (SCCACHE_DIR in .cargo/config.toml).
/.sccache/

# ── Editors / agents / OS ─────────────────────────────────────────────────────
.idea/
.vscode/
.zed/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.bak
__pycache__/
*.pyc
*~

# Linux Swift and device build state.
/ios/.build/
/ios/.cache/
/ios/.swiftpm/
/ios/UITestsPkg/.build/
/ios/UITestsPkg/.swiftpm/
/ios/xtool/
/data/run/

# Local signing work and App Store Connect private keys.
/data/signing/
*.p8

# Host-only development credentials and local configuration.
/data/internal/
