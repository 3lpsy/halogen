# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Generated by Cargo
/target/
**/target/

# Dioxus
# Ignore the built frontend, but keep the dist/ directory itself in git (via its
# .gitignore keeper). The server's rust_embed (#[folder = "../../dist"]) needs the
# folder to EXIST at compile time, incl. fresh CI checkouts — `just ui-build` then
# fills it. Without the keeper, a clean checkout has no dist/ and the workspace
# check fails to compile (embed-frontend is pulled in via the e2e crate).
/dist/*
!/dist/.gitignore
.dioxus/

# Cargo lock for libraries (remove this line for binaries/apps)
# Cargo.lock

# Staged debug binary the dev-release CI copies into the ci/docker/dev build context.
/halogen-server

